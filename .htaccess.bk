
# ============================================================
# Sécurité — règles personnalisées
# ============================================================

# Désactiver la liste des répertoires
Options -Indexes

# Bloquer l'accès aux fichiers sensibles
<FilesMatch "^(wp-config\.php|\.htaccess|readme\.html|license\.txt|wp-config-sample\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquer xmlrpc.php (vecteur d'attaque brute-force)
<Files xmlrpc.php>
    Order allow,deny
    Deny from all
</Files>

# Bloquer l'accès aux fichiers de debug
<Files debug.log>
    Order allow,deny
    Deny from all
</Files>

# Bloquer accès aux fichiers markdown, scripts shell et SQL dans wp-content
<FilesMatch "\.(md|pot|sh|sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================================
# Performance — Cache navigateur (fichiers statiques)
# ============================================================



# ============================================================
# BEGIN WordPress
# Les directives (lignes) entre « BEGIN WordPress » et « END WordPress » sont générées
# dynamiquement, et doivent être modifiées uniquement via les filtres WordPress.
# Toute modification des directives situées entre ces marqueurs sera surchargée.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /homedesk/
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /homedesk/index.php [L]
</IfModule>

# END WordPress